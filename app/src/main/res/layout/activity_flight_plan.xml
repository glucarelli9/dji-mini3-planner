<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Mapa ocupa la pantalla completa -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Panel de control superpuesto - lado derecho -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC1A1A2E"
        android:padding="12dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvWaypointCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waypoints: 0"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvAltitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Altitud: 30m"
            android:textColor="#A0D0FF"
            android:textSize="13sp"/>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderAltitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="5"
            android:valueTo="120"
            android:value="30"
            android:stepSize="5"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vel: 5 m/s"
            android:textColor="#A0D0FF"
            android:textSize="13sp"/>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="1"
            android:valueTo="15"
            android:value="5"
            android:stepSize="1"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvMissionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado: Inactivo"
            android:textColor="#80FF80"
            android:textSize="12sp"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFly"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="▶ Volar"
            app:backgroundTint="#FF6B35"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="■ Detener"
            app:backgroundTint="#CC2222"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportWpmz"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="↓ Exportar .wpmz"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="✕ Limpiar"
            style="@style/Widget.Material3.Button.TextButton"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
